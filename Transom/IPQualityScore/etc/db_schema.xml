<?xml version="1.0"?>

<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="ipqs_api_request">
        <column xsi:type="int" name="ipqs_api_request_id" padding="10" identity="true" unsigned="true" nullable="false" comment="IPQS API Request ID"/>
        <column xsi:type="varchar" name="type" nullable="false" length="20" comment="Event type"/>
        <column xsi:type="text" name="data" nullable="false" comment="Data"/>
        <column xsi:type="int" name="fraud_score" unsigned="false" nullable="false" comment="Fraud Score"/>
        <column xsi:type="boolean" name="bot_status" nullable="false" comment="Bot Status"/>
        <column xsi:type="timestamp" name="updated" nullable="false" on_update="true" default="CURRENT_TIMESTAMP" comment="Updated"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="ipqs_api_request_id"/>
        </constraint>
    </table>


    <table name="ipqs_order_score">
        <column xsi:type="int" name="ipqs_order_score_id" padding="10" identity="true" unsigned="true" nullable="false" comment="IPQS Order Score ID"/>
        <column xsi:type="int" name="order_id" padding="10" unsigned="true" nullable="false" comment="Order Id"/>
        <column xsi:type="int" name="fraud_score" unsigned="false" nullable="false" comment="Fraud Score"/>
        <column xsi:type="int" name="risk_score" unsigned="false" nullable="false" comment="Risk Score"/>
        <column xsi:type="boolean" name="bot_status" nullable="false" comment="Bot Status"/>
        <column xsi:type="timestamp" name="updated" nullable="false" on_update="true" default="CURRENT_TIMESTAMP" comment="Updated"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="ipqs_order_score_id"/>
        </constraint>

        <!--
        <constraint xsi:type="foreign" referenceId="IPQS_ORDER_SCORE_ORDER_ID_SALES_ORDER_ENTITY_ID" table="ipqs_order_score" column="order_id" referenceTable="sales_order" referenceColumn="entity_id" onDelete="CASCADE"/>
        -->
    </table>

</schema>
